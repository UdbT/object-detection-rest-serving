{"openapi": "3.1.0", "info": {"title": "Object Detection Serving", "version": "1.0.0"}, "paths": {"/health_check": {"get": {"summary": "Health Check", "description": "Health check endpoint.\n\nReturns:\n    JSONResponse: 200 status", "operationId": "healthcheck_health_check_get", "responses": {"200": {"description": "Successful health check", "content": {"application/json": {"schema": {}}}}}}}, "/v1/forward": {"post": {"tags": ["forward"], "summary": "Forward", "description": "Run object detection on the provided image.\n\nArgs:\n    input_data (ObjectDetectionRequest): Structured request including the image to be processed.\n    request (Request): FastAPI request object for accessing app state (model registry).\n\nReturns:\n    ObjectDetectionResponse: The response containing the detection results.", "operationId": "forward_v1_forward_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ObjectDetectionRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ObjectDetectionResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}}, "components": {"schemas": {"DetectedObject": {"properties": {"bbox": {"items": {"type": "number"}, "type": "array", "title": "Bbox", "description": "Bounding box coordinates [x, y, x2, y2]"}, "score": {"type": "number", "title": "Score", "description": "Detection score"}, "label": {"type": "string", "title": "Label", "description": "Class label of the detected object"}}, "type": "object", "required": ["bbox", "score", "label"], "title": "DetectedObject", "description": "Model representing a detected object."}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "ObjectDetectionRequest": {"properties": {"image": {"type": "string", "title": "Image", "description": "Base64 encoded image string"}}, "type": "object", "required": ["image"], "title": "ObjectDetectionRequest", "description": "Request model for object detection API."}, "ObjectDetectionResponse": {"properties": {"detections": {"items": {"$ref": "#/components/schemas/DetectedObject"}, "type": "array", "title": "Detections", "description": "List of detected objects"}}, "type": "object", "required": ["detections"], "title": "ObjectDetectionResponse", "description": "Response model for object detection API."}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}}}}